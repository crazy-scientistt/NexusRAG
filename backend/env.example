# ============================================================================
# RAG V2 Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# HuggingFace Token - REQUIRED
# ----------------------------------------------------------------------------
# Get from: https://huggingface.co/settings/tokens
# Create "Fine-grained" token with "Inference Providers" permission
HF_TOKEN=your_huggingface_token_here


# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Choose ONE option below:

# Option 1: Supabase PostgreSQL - RECOMMENDED FOR PRODUCTION
# Get from: Supabase Dashboard -> Settings -> Database -> Connection String
# The password will be automatically inserted from SUPABASE_PASSWORD env var
# Direct pooler connection (recommended):
SUPABASE_DB_URL=postgresql://postgres.[PROJECT]:${SUPABASE_PASSWORD}@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Or set password separately for security:
# SUPABASE_PASSWORD=your_secure_password_here

# Transaction pooler (alternative):
# DATABASE_URL=postgresql://postgres:${SUPABASE_PASSWORD}@db.[PROJECT].supabase.co:5432/postgres

# Option 2: Standard PostgreSQL (Heroku, Neon, Railway, etc.)
# DATABASE_URL=postgresql://user:${DB_PASSWORD}@host:5432/database
# DB_PASSWORD=your_db_password_here

# Option 3: SQLite - For local development only (comment out above)
# DB_PATH=./data/rag.db


# ----------------------------------------------------------------------------
# CORS - Frontend Origins
# ----------------------------------------------------------------------------
# Add your frontend URLs (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ----------------------------------------------------------------------------
# File Upload Settings
# ----------------------------------------------------------------------------
# Maximum file size in MB
MAX_FILE_MB=20

# Temporary document time-to-live in minutes (24 hours = 1440)
TEMP_DOC_TTL_MIN=1440


# ----------------------------------------------------------------------------
# RAG Behavior
# ----------------------------------------------------------------------------
# Strict mode: Only use context from uploaded documents
DEFAULT_STRICT=false

# Number of top results to retrieve
TOP_K_RESULTS=4


# ----------------------------------------------------------------------------
# Firebase Authentication (Optional)
# ----------------------------------------------------------------------------
# For cloud deployment, use JSON credentials:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# For local development, use file path:
# FIREBASE_CREDENTIALS=./firebase-credentials.json


# ----------------------------------------------------------------------------
# Payment Features (Optional)
# ----------------------------------------------------------------------------
# Enable/disable payment features
PAYMENT_ENABLED=true


# ============================================================================
# IMPORTANT NOTES:
# ============================================================================
# 
# 1. DATABASE_URL vs DB_PATH:
#    - Use DATABASE_URL for PostgreSQL (Supabase, Neon, etc.)
#    - Use DB_PATH for SQLite (local development only)
#    - If DATABASE_URL is set, it takes precedence over DB_PATH
#
# 2. Security:
#    - NEVER commit this file with real credentials!
#    - Add .env to .gitignore
#    - Use different credentials for production
#
# 3. Supabase Free Tier:
#    - 500 MB database storage
#    - Unlimited API requests
#    - No credit card required
#    - Perfect for MVP and testing
#
# 4. Connection String Format:
#    postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
#
#    Example:
#    postgresql://postgres:mySecurePass123@db.abc123xyz.supabase.co:5432/postgres
#
# ============================================================================
