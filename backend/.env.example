# ============================================================================
# RAG V2 Environment Configuration - SECURE TEMPLATE
# ============================================================================
# 
# SECURITY NOTES:
# - This is a TEMPLATE file - safe to commit to Git
# - Copy this to .env and add your actual credentials
# - NEVER commit .env with real credentials
# - Add .env to .gitignore (it should already be there)
#
# ============================================================================

# ----------------------------------------------------------------------------
# HuggingFace Token - REQUIRED
# ----------------------------------------------------------------------------
# Get from: https://huggingface.co/settings/tokens
# Create "Fine-grained" token with "Inference Providers" permission
HF_TOKEN=your_huggingface_token_here


# ----------------------------------------------------------------------------
# Database Configuration - CHOOSE ONE OPTION
# ----------------------------------------------------------------------------

# ============================
# Option 1: Supabase (RECOMMENDED - Most Secure Setup)
# ============================
# 
# Step 1: Get your connection string from Supabase dashboard
#         Settings → Database → Connection String → Pooler (Transaction mode)
#
# Step 2: Replace [PROJECT] and [REGION] below (keep the ${SUPABASE_PASSWORD})
# 
SUPABASE_DB_URL=postgresql://postgres.[PROJECT]:${SUPABASE_PASSWORD}@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Step 3: Add your actual password here (NEVER commit this!)
#
SUPABASE_PASSWORD=your_supabase_password_here
#
# ✅ BENEFITS: 
#    - Password stored separately from connection string
#    - Easy password rotation (just change SUPABASE_PASSWORD)
#    - Works great with CI/CD secrets
#    - Team-friendly (share template, not password)
#

# ============================
# Option 2: Supabase (Simple - Less Secure)
# ============================
# If you prefer to put password directly in the URL:
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT]:your_password@aws-0-[REGION].pooler.supabase.com:6543/postgres
# ⚠️  NOT RECOMMENDED for production or team projects

# ============================
# Option 3: Standard PostgreSQL
# ============================
# For Heroku, Neon, Railway, or other PostgreSQL providers:
# DATABASE_URL=postgresql://user:${DB_PASSWORD}@host:5432/database
# DB_PASSWORD=your_database_password

# ============================
# Option 4: SQLite (Local Development Only)
# ============================
# Uncomment if you want to use local SQLite database:
# DB_PATH=./data/rag.db


# ----------------------------------------------------------------------------
# CORS - Frontend Origins
# ----------------------------------------------------------------------------
# Add your frontend URLs (comma-separated, no spaces)
# Development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: Add your deployed frontend URL
# ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com


# ----------------------------------------------------------------------------
# File Upload Settings
# ----------------------------------------------------------------------------
# Maximum file size in MB
MAX_FILE_MB=20

# Temporary document time-to-live in minutes (24 hours = 1440)
TEMP_DOC_TTL_MIN=1440


# ----------------------------------------------------------------------------
# RAG Behavior
# ----------------------------------------------------------------------------
# Strict mode: Only use context from uploaded documents
DEFAULT_STRICT=false

# Number of top results to retrieve from vector database
TOP_K_RESULTS=4


# ----------------------------------------------------------------------------
# Firebase Authentication (Optional)
# ----------------------------------------------------------------------------
# For cloud deployment, use JSON credentials:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# For local development, use file path:
# FIREBASE_CREDENTIALS=./firebase-credentials.json


# ----------------------------------------------------------------------------
# Payment Features (Optional)
# ----------------------------------------------------------------------------
# Enable/disable payment features
PAYMENT_ENABLED=true


# ============================================================================
# DEPLOYMENT GUIDE
# ============================================================================
#
# LOCAL DEVELOPMENT:
# ------------------
# 1. Copy this file to .env
# 2. Replace placeholder values with real credentials
# 3. Never commit .env file
#
# GITHUB ACTIONS:
# --------------
# Add secrets in: Repository Settings → Secrets and variables → Actions
# - SUPABASE_PASSWORD
# - HF_TOKEN
# - FIREBASE_CREDENTIALS_JSON (if using)
#
# Then in your workflow:
# env:
#   SUPABASE_PASSWORD: ${{ secrets.SUPABASE_PASSWORD }}
#   HF_TOKEN: ${{ secrets.HF_TOKEN }}
#
# HEROKU/RAILWAY:
# --------------
# heroku config:set SUPABASE_PASSWORD=your_password
# heroku config:set HF_TOKEN=your_token
# heroku config:set SUPABASE_DB_URL=postgresql://...
#
# Or via dashboard: Settings → Config Vars
#
# DOCKER:
# ------
# docker run \
#   -e SUPABASE_PASSWORD=your_password \
#   -e HF_TOKEN=your_token \
#   -e SUPABASE_DB_URL=postgresql://... \
#   your-image
#
# Or use docker-compose with env_file:
# env_file:
#   - .env.production
#
# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
#
# ✅ .env is in .gitignore
# ✅ Using ${SUPABASE_PASSWORD} syntax (not hardcoded password in URL)
# ✅ Different passwords for dev/staging/production
# ✅ Passwords stored in CI/CD secrets (not in workflow files)
# ✅ Team members have their own .env files (not shared)
# ✅ Using environment-specific .env files (.env.dev, .env.prod)
# ✅ Password rotation plan in place
# ✅ SSL enabled for database connections (automatic for Supabase)
#
# ============================================================================
