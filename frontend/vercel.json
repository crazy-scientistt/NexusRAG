{
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/me", "destination": "/api/index" },
    { "source": "/stats", "destination": "/api/index" },
    { "source": "/models", "destination": "/api/index" },
    { "source": "/sessions", "destination": "/api/index" },
    { "source": "/sessions/(.*)", "destination": "/api/index" },
    { "source": "/upload", "destination": "/api/index" },
    { "source": "/documents", "destination": "/api/index" },
    { "source": "/documents/(.*)", "destination": "/api/index" },
    { "source": "/clear", "destination": "/api/index" },
    { "source": "/((?!api|health|me|stats|models|sessions|upload|documents|clear).*)", "destination": "/index.html" }
  ]
}
