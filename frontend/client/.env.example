# ============================================================================
# NexusRAG Frontend Cloud Environment Template
# ============================================================================

# 1. Backend API Endpoint (REQUIRED for cloud deployment)
# Set to your public backend URL (e.g., on Render, Railway, Fly.io)
# Example: https://nexusrag-api.onrender.com
VITE_API_URL=http://localhost:8000

# 2. Firebase Authentication (OPTIONAL - only if using Google/Firebase Auth)
# If left unset, the app uses Guest & Developer Mode with one-click Studio access.
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-app
# VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
