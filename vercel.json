{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "api": {
      "root": "backend/",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/models", "destination": { "service": "api" } },
    { "source": "/sessions/:path*", "destination": { "service": "api" } },
    { "source": "/sessions", "destination": { "service": "api" } },
    { "source": "/upload", "destination": { "service": "api" } },
    { "source": "/documents/:path*", "destination": { "service": "api" } },
    { "source": "/documents", "destination": { "service": "api" } },
    { "source": "/clear", "destination": { "service": "api" } },
    { "source": "/stats", "destination": { "service": "api" } },
    { "source": "/me", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
