{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/api", "dest": "api/index.py" },
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/me", "dest": "api/index.py" },
    { "src": "/stats", "dest": "api/index.py" },
    { "src": "/models", "dest": "api/index.py" },
    { "src": "/sessions", "dest": "api/index.py" },
    { "src": "/sessions/(.*)", "dest": "api/index.py" },
    { "src": "/upload", "dest": "api/index.py" },
    { "src": "/documents", "dest": "api/index.py" },
    { "src": "/documents/(.*)", "dest": "api/index.py" },
    { "src": "/clear", "dest": "api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
